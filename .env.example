# Public canonical URL. Set before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Forms post to your own HTTPS endpoint. Leave empty for honest preview mode.
DEKORAJ_ENQUIRY_WEBHOOK_URL=
# Optional server-to-server bearer token; never use NEXT_PUBLIC_ for this.
DEKORAJ_ENQUIRY_WEBHOOK_TOKEN=
# Optional live availability endpoint, following docs/INTEGRATION.md.
DEKORAJ_AVAILABILITY_URL=
DEKORAJ_AVAILABILITY_TOKEN=
